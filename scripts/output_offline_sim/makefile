OPTIMISATIONS = -I"/home/liorb/projects/ca3net/.venv/include" -w -O3 -ffast-math -fno-finite-math-only -march=native -std=c++11
CXXFLAGS = -c -Wno-write-strings $(OPTIMISATIONS) -I.  -g -DDEBUG
